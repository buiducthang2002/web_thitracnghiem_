rules_version = '2';

// Quy tắc bảo mật Firestore cho hệ thống thi trắc nghiệm.
//
// Mô hình phân quyền:
//   - Đăng nhập bằng Firebase Authentication (email nội bộ <tài khoản>@quiz.local).
//   - Collection `users/{uid}` quyết định vai trò: { role: 'admin' | 'employee', empId }.
//     Chỉ admin được ghi `users`; tài khoản tự đăng ký (không có doc users) KHÔNG có quyền gì.
//   - admin: đọc/ghi toàn bộ.
//   - thí sinh: đọc câu hỏi + đề thi, đọc hồ sơ và kết quả CỦA MÌNH, chỉ được TẠO kết quả của mình
//     (không sửa, không xoá).
//
// Admin đầu tiên tạo bằng: node scripts/adminTools.mjs create-admin <tài khoản> <mật khẩu>
//
// Giới hạn còn lại: thí sinh đọc được trường `ans` của câu hỏi và điểm do trình duyệt tự chấm.
// Muốn chặn hẳn phải chuyển việc chấm điểm lên Cloud Functions.

service cloud.firestore {
  match /databases/{database}/documents {

    function hasProfile() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return hasProfile() && profile().role == 'admin'; }
    function isEmp()   { return hasProfile() && profile().role == 'employee'; }

    // ── Vai trò người dùng ────────────────────────────────
    // { role: 'admin' | 'employee', empId?: number, account?: string }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin() &&
        request.resource.data.role in ['admin', 'employee'];
      allow delete: if isAdmin();
    }

    // ── Thí sinh ──────────────────────────────────────────
    // { id, name: string, dept: string, account?: string }
    match /employees/{id} {
      allow read: if isAdmin() || (isEmp() && resource.data.id == profile().empId);
      allow delete: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasAll(['id', 'name', 'dept']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 200 &&
        request.resource.data.dept is string;
    }

    // ── Ngân hàng câu hỏi ─────────────────────────────────
    // { id, topic: string, level: string, text: string, opts: string[], ans: number, order?: number }
    match /questions/{id} {
      allow read: if isAdmin() || isEmp();
      allow delete: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasAll(['id', 'text', 'opts', 'ans']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.opts is list &&
        request.resource.data.opts.size() >= 2 &&
        request.resource.data.opts.size() <= 10 &&
        request.resource.data.ans is number;
    }

    // ── Đề thi ────────────────────────────────────────────
    // { id, title: string, topic: string, qIds: number[], time: number, pass: number, desc: string }
    match /exams/{id} {
      allow read: if isAdmin() || isEmp();
      allow delete: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasAll(['id', 'title', 'qIds', 'time', 'pass']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.qIds is list &&
        request.resource.data.time is number &&
        request.resource.data.pass is number;
    }

    // ── Kết quả bài thi ───────────────────────────────────
    // { id, empId, examId, score, correct, timeTaken, date: string, answers: number[] }
    match /results/{id} {
      allow read: if isAdmin() || (isEmp() && resource.data.empId == profile().empId);

      // Thí sinh chỉ tạo mới kết quả của chính mình (không ghi đè được kết quả đã có).
      allow create: if (isAdmin() || (isEmp() && request.resource.data.empId == profile().empId)) &&
        request.resource.data.keys().hasAll(['id', 'empId', 'examId', 'score', 'correct', 'date']) &&
        request.resource.data.score is number &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= 100 &&
        request.resource.data.correct is number &&
        request.resource.data.date is string;

      allow update, delete: if isAdmin();
    }

    // ── Chặn mọi đường dẫn khác ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
